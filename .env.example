# App
PORT=3000
NODE_ENV=development

# WhatsApp Session
WA_AUTH_DIR=./auth_info
WA_PRINT_QR=true

# Bulk Settings
WA_DELAY_BETWEEN_MESSAGES=1500   # ms between each message to avoid ban
WA_MAX_RETRIES=3                 # retry failed messages

# Rate Limiting (optional)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
